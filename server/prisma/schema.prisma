datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Token {
  id           String   @id @default(cuid())
  spotifyId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  tokenType    String   @default("Bearer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}